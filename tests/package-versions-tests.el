;;; package-versions-tests.el --- Package sync integration checks -*- lexical-binding: t; -*-

(require 'ert)
(load (expand-file-name "scripts/package-versions.el" user-emacs-directory) nil t)

(ert-deftest my/package-sync-fetches-pins-and-preserves-local-edits ()
  (let* ((root (make-temp-file "package-sync-" t))
         (user-emacs-directory (file-name-as-directory root))
         (origin (expand-file-name "origin" root))
         (checkout (expand-file-name "straight/repos/example" root))
         (lockfile (expand-file-name "straight/versions/default.el" root))
         first second warnings)
    (unwind-protect
        (progn
          (make-directory origin)
          (my/package-git origin "init" "--quiet")
          (my/package-git origin "config" "user.name" "Package sync test")
          (my/package-git origin "config" "user.email" "test@example.invalid")
          (with-temp-file (expand-file-name "example.el" origin) (insert "first\n"))
          (my/package-git origin "add" "example.el")
          (my/package-git origin "commit" "--quiet" "-m" "First")
          (setq first (my/package-git origin "rev-parse" "HEAD"))
          (make-directory (file-name-directory checkout) t)
          (my/package-git root "clone" "--quiet" origin checkout)
          (with-temp-file (expand-file-name "example.el" origin) (insert "second\n"))
          (my/package-git origin "commit" "--quiet" "-am" "Second")
          (setq second (my/package-git origin "rev-parse" "HEAD"))
          (make-directory (file-name-directory lockfile) t)
          (with-temp-file lockfile
            (prin1 `(("example" . ,second) ("unused" . ,first)) (current-buffer))
            (insert "\n:gamma\n"))
          (cl-letf (((symbol-function 'display-warning)
                     (lambda (_type message &rest _) (push message warnings))))
            (my/warn-package-version-differences))
          (should (string-match-p "just sync-packages" (car warnings)))
          (should (string-match-p "example" (car warnings)))
          (with-temp-file (expand-file-name "local-work" checkout) (insert "keep me\n"))
          (should-error (my/sync-package-versions) :type 'error)
          (should (equal (my/package-git checkout "rev-parse" "HEAD") first))
          (should (file-exists-p (expand-file-name "local-work" checkout)))
          (delete-file (expand-file-name "local-work" checkout))
          (my/sync-package-versions)
          (should (equal (my/package-git checkout "rev-parse" "HEAD") second))
          (my/sync-package-versions)
          (setq warnings nil)
          (cl-letf (((symbol-function 'display-warning)
                     (lambda (&rest arguments) (push arguments warnings))))
            (my/warn-package-version-differences))
          (should-not warnings))
      (delete-directory root t))))
